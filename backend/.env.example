APP_NAME=法律咨询助手
DEBUG=True
SECRET_KEY=your-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库（与 docker-compose.yml 中的凭据保持一致）
DATABASE_URL=postgresql://legal_user:legal_pass@localhost:5432/legal_db
REDIS_URL=redis://localhost:6379/0

# LLM 配置
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-xxx
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_API_BASE=https://api.deepseek.com/v1

# Embedding 配置
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh
EMBEDDING_DIMENSION=512

# 向量库配置
VECTOR_STORE=chroma
VECTOR_STORE_PATH=./data/chroma
BM25_INDEX_PATH=./data/bm25_index.pkl

# RAG 配置
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
RERANK_ENABLED=True

# Context 管理（历史视图裁剪 + 增量摘要压缩）
HISTORY_CHAR_BUDGET=6000
SUMMARY_TRIGGER_CHARS=2000
SUMMARY_MAX_CHARS=400

# Self-Reflection 质量门控
REFLECTION_ENABLED=True
REFLECTION_MAX_ROUNDS=1
REFLECTION_SCORE_THRESHOLD=0.6

# LangSmith 全链路追踪
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_PROJECT=legal
